generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())

  projects     Project[]
  incidents    Incident[]
}

model Project {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())

  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])

  services  Service[]

  @@index([ownerId])
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Incident {
  id        String   @id @default(cuid())

  title     String?
  log       String

  severity  String?
  errorType String?
  rootCause String?
  solution  String?

  status    String   @default("ANALYZED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}