generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())

  projects     Project[]
}

model Project {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())

  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])

  services  Service[]

  @@index([ownerId])
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])

  @@index([projectId])
}